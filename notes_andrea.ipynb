    "import pandas as pd\n",
    "from pooch import retrieve\n",
    "\n",
    "# Read data, put in pandas dataframe\n",
    "url = \"https://osf.io/download/qsb3f\"\n",
    "path = retrieve(url=url, known_hash=None)\n",
    "df = pd.read_csv(path, encoding=\"latin1\")\n",
    "print(df.head())"
   ]
